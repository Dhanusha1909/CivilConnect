# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/rootcauseai

# Server port
PORT=5000

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# OPTIONAL: Google Gemini API key. If set, the system uses Google Gemini to generate
# richer root-cause explanations and recommended actions for complaint
# clusters. If NOT set, the system falls back to its own built-in
# keyword/statistics-based heuristic engine, so the project runs fully
# standalone without any external API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Officer signup passcode (simple gate so random citizens can't self-register
# as officers). Give this to real officers only.
OFFICER_SIGNUP_CODE=OFFICER2026
